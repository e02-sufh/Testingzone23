{
  "name": "e02-sufh/testingzone23",
  "description": "CodeIgniter 4 starter for Testingzone23",
  "require": {
    "php": ">=8.5",
    "codeigniter4/framework": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
